{
  "name": "dshup",
  "version": "1.0.0",
  "description": "dshup — DeepSeek Harness Windows 桌面客户端：自动检测/安装依赖（国内镜像）、内嵌显示、开机自启、语音输入（MiMo ASR / FunASR 一键部署）、用量统计",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangjiabo522/dshup.git"
  },
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . DeepSeekHarnessClient --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --app-version=1.0.0 --ignore=\"^(/dist($|/)|/test-bootstrap\\.js$|/test-install\\.js$|/README\\.md$|/启动客户端\\.bat$)\"",
    "dist:installer": "electron-builder --win nsis",
    "test:bootstrap": "node test-bootstrap.js"
  },
  "build": {
    "appId": "com.deepseekai.dsh-client",
    "productName": "DeepSeek Harness",
    "artifactName": "dshup-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "bootstrap.js",
      "stats-script.js",
      "funasr-deploy.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
